{%- endmacro %}

{% macro icon(name, cls="") -%}
<svg class="ic{% if cls %} {{ cls }}{% endif %}{% if name == 'i-running' %} spin{% endif %}" aria-hidden="true" focusable="false"><use href="#{{ name }}"></use></svg>
{%- endmacro %}

{% macro chip(tone_class, icon_name, text, cls="") -%}
<span class="chip {{ tone_class }}{% if cls %} {{ cls }}{% endif %}">{{ icon(icon_name) }}<span>{{ text }}</span></span>
{%- endmacro %}

{% macro verdict_chip(verdict, cls="") -%}
{{ chip(verdict|verdict_class, verdict|verdict_icon, verdict|verdict_label, cls) }}
{%- endmacro %}

{% macro status_chip(status, cls="") -%}
{{ chip(status|status_class, status|status_icon, status|status_label, cls) }}
{%- endmacro %}

{% macro score_inline(score) -%}
{%- set t = score|fmt_score -%}
{%- if t != "—" -%}<span class="score-inline"><span class="n">{{ t }}</span><span class="d">/100</span></span>
{%- else -%}<span class="muted">no score</span>{%- endif -%}
{%- endmacro %}

{% macro scorebar(score, verdict) -%}
{%- if score|fmt_score != "—" -%}<span class="bar thin {{ verdict|verdict_class }}" aria-hidden="true"><span class="fill w-{{ score|pct_step }}"></span></span>{%- endif -%}
{%- endmacro %}

{#- Axis-score meter; `score` is already on the 0..100 scale. -#}
{% macro meter(score, pass_line=75) -%}
{%- if score is number -%}
<span class="meter"><span class="meter-track" aria-hidden="true"><span class="meter-fill{% if score < pass_line %} below{% endif %} w-{{ score|pct_step }}"></span><span class="meter-pass l-{{ pass_line|pct_step }}"></span></span><span class="meter-num">{{ score|fmt_score }}</span></span>
{%- else -%}<span class="muted">—</span>{%- endif -%}
{%- endmacro %}

{% macro counts(run) -%}
{%- set cs = run|module_counts -%}
{%- if cs -%}<span class="counts">{% for c in cs %}<span class="count tone-{{ c.tone }}" title="{{ c.text }}">{{ icon(c.icon) }}{{ c.n }}<span class="visually-hidden"> {{ c.label|lower }}</span></span>{% endfor %}</span>
{%- else -%}<span class="muted">—</span>{%- endif -%}
{%- endmacro %}

{% macro time(value) -%}
{%- set iso = value|fmt_iso -%}
{%- if iso -%}<time datetime="{{ iso }}" title="{{ iso }}">{{ value|fmt_time }}</time>{%- else -%}{{ value|fmt_time }}{%- endif -%}
{%- endmacro %}

{% macro csrf_field(token) -%}
<input type="hidden" name="csrf" value="{{ token or '' }}">
{%- endmacro %}

{% macro gate_badge(gate) -%}
{%- if gate == "hard" -%}<span class="badge gate-hard" title="A failure blocks promotion and fails CI">hard gate</span>
{%- elif gate == "warn" -%}<span class="badge gate-warn" title="A failure is reported but does not block">warn gate</span>
{%- elif gate -%}<span class="badge">{{ gate }}</span>{%- endif -%}
{%- endmacro %}

{% macro screening_badge() -%}
<span class="badge screening" title="Screening test: it can find evidence of a problem but cannot prove its absence">{{ icon("i-screen") }}<span>Screening</span></span>
{%- endmacro %}

{% macro copy_button(target_id, label="Copy") -%}
<button type="button" class="btn small ghost js-only" data-copy="{{ target_id }}" aria-label="{{ label }} to the clipboard">{{ icon("i-copy") }}<span>{{ label }}</span></button>
{%- endmacro %}

{#- A shell command with a copy button; `id` must be unique on the page. -#}
{% macro cmd(id, text) -%}
<div class="cmd"><pre><span class="cmd-prompt" aria-hidden="true">$ </span><code id="{{ id }}">{{ text }}</code></pre>{{ copy_button(id) }}</div>
{%- endmacro %}

{#- A copyable minimal adapter (collapsed); `id` must be unique on the page. -#}
{% macro adapter_skeleton(text, id) -%}
<details class="more skeleton" data-adapter-skeleton>
<summary>Adapter skeleton to copy</summary>
<div class="more-body">
<div class="cmd"><pre class="code"><code id="{{ id }}">{{ text }}</code></pre>{{ copy_button(id) }}</div>
<p class="help">Save it next to your model as <code>adapter.py</code>, edit the values, then upload both on the New run page (“Advanced: own adapter”). The bundled examples in <code>examples/</code> of the MalValid source show complete adapters for LightGBM and XGBoost.</p>
</div>
</details>
{%- endmacro %}

{#- One-click form that submits the bundled synthetic demo in path mode. -#}
{% macro demo_form(demo, csrf_token) -%}
<form method="post" action="{{ root }}/runs" enctype="multipart/form-data" data-demo-form>
{{ csrf_field(csrf_token) }}
<input type="hidden" name="mode" value="path">
<input type="hidden" name="adapter_path" value="{{ demo.adapter_path }}">
<input type="hidden" name="config_path" value="{{ demo.config_path }}">
<input type="hidden" name="title" value="{{ demo.title }}">
<button type="submit" class="btn">{{ icon("i-play") }}<span>Run the synthetic demo</span></button>
</form>
{%- endmacro %}

{#- The 0-100 verdict scale (bands + score marker), from report_view(...).verdict. -#}
{% macro scale(vd) -%}
{%- set cm = vd.cond_min|pct_step -%}
{%- set rm = vd.ready_min|pct_step -%}
<div class="scale" role="img" aria-label="Score {{ vd.score|fmt_score }} on a 0 to 100 scale: not ready below {{ cm }}, conditional from {{ cm }}, ready from {{ rm }}.">
<div class="scale-track">
<span class="band band-serious l-0 w-{{ cm }}"></span>
<span class="band band-warning l-{{ cm }} w-{{ rm - cm }}"></span>
<span class="band band-good l-{{ rm }} w-{{ 100 - rm }}"></span>
{% if vd.show_cap %}<span class="cap-mark l-{{ vd.cap|pct_step }}"><span class="cap-lbl">blocked cap {{ vd.cap|fmt_score(0) }}</span></span>{% endif %}
{% if vd.raw is not none %}<span class="marker marker-raw l-{{ vd.raw|pct_step }}" title="uncapped score {{ vd.raw|fmt_score }}"></span>{% endif %}
{% if vd.score is not none %}<span class="marker l-{{ vd.score|pct_step }}"></span>{% endif %}
</div>
<div class="scale-labels" aria-hidden="true"><span class="first l-0">0</span><span class="l-{{ cm }}">{{ cm }}</span><span class="l-{{ rm }}">{{ rm }}</span><span class="last l-100">100</span></div>
<p class="scale-legend" aria-hidden="true"><span><i class="k-serious"></i>Not ready</span><span><i class="k-warning"></i>Conditional</span><span><i class="k-good"></i>Ready</span></p>
</div>
{%- endmacro %}

{#- One row of the live module list (app.js builds the same markup). -#}
{% macro module_row(m) -%}
<li class="status-{{ m.status }}" data-module="{{ m.id }}">
<span>{{ chip("tone-" ~ m.tone, m.icon, m.status_label) }}</span>
<span class="mod-code">{{ m.code }}</span>
<span class="mod-title">{{ m.title }}</span>
<span class="mod-dur">{% if m.duration_s is not none and m.status in ("pass", "warn", "fail", "error") %}{{ m.duration_s|fmt_duration }}{% endif %}</span>
</li>
{%- endmacro %}

{% macro stepper(steps) -%}
<ol class="stepper" data-live-steps>
{% for s in steps %}<li class="{{ s.state }}" data-step="{{ s.key }}"{% if s.state == "current" %} aria-current="step"{% endif %}>{{ icon("i-check" if s.state == "done" else ("i-running" if s.state == "current" else "i-pending")) }}<span>{{ s.label }}<span class="visually-hidden">{% if s.state == "done" %} (done){% elif s.state == "current" %} (in progress){% endif %}</span></span></li>
{% endfor %}
</ol>
{%- endmacro %}
